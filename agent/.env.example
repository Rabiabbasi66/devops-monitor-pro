# DevOps Monitor Pro - Agent Environment Configuration Example
# Copy this file to .env and update with your actual values
# NOTE: For new installations, use --enroll token instead of setting these manually

# Backend API URL
API_URL=http://localhost:8000/api

# Server ID (auto-populated via enrollment)
# SERVER_ID=

# Agent Token (auto-populated via enrollment)
# AGENT_TOKEN=

# Metrics collection interval in seconds
INTERVAL_SECONDS=30
