# DevOps Monitor Pro - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME=DevOps Monitor Pro
DEBUG=true
ENVIRONMENT=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=devops_monitor_pro

# Security Settings
SECRET_KEY=change-me-in-production-use-a-strong-random-string-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
ALLOWED_ORIGINS=["*"]
FRONTEND_URL=http://localhost:8501
BACKEND_URL=http://localhost:8000

# Rate Limiting & Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
RATE_LIMIT_PER_MINUTE=60
PASSWORD_MIN_LENGTH=8
REQUIRE_PASSWORD_SPECIAL_CHARS=true
SESSION_TIMEOUT_MINUTES=60
ENABLE_CORS_HEADERS=true

# Monitoring Configuration
METRIC_RETENTION_DAYS=30
ALERT_COOLDOWN_SECONDS=300
SERVER_OFFLINE_THRESHOLD_SECONDS=120
HEALTH_CHECK_INTERVAL_SECONDS=60

# Email Notification Settings (platform-managed SMTP)
# Clients only configure their recipient email - never SMTP credentials.
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=DevOps Monitor Pro

# WhatsApp Notification Settings (Meta WhatsApp Cloud API, platform sender)
# Clients only connect their destination phone number.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_TIMEOUT=30

# Telegram Notification Settings (one platform bot)
# Clients connect via one-time tokens; the bot token stays server-side.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_TIMEOUT=30
TELEGRAM_PARSE_MODE=HTML
# Optional static bot username for deep links (otherwise resolved via getMe)
TELEGRAM_BOT_USERNAME=
# Shared secret to verify Telegram webhook calls (set_webhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# One-time Telegram connection token lifetime (minutes)
TELEGRAM_CONNECT_TOKEN_EXPIRE_MINUTES=15